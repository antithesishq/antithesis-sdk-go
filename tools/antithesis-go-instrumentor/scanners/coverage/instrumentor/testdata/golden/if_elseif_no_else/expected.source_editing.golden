//line input.go:1:1
package sample; import __antithesis_instrumentation__ "antithesis.notifier/instrumentation"

// Grade has an `else if` with no trailing else, so the instrumentor synthesizes
// the "not taken" else for the else-if's inner if. That synthesized else must
// land inside the wrapper block, not after it (else: dangling else).
func Grade(n int) string {__antithesis_instrumentation__.Notify(1)
	if n >= 90 {__antithesis_instrumentation__.Notify(3)
		return "A"
	} else {__antithesis_instrumentation__.Notify(4); if n >= 80 {__antithesis_instrumentation__.Notify(5)
		return "B"
	} else {__antithesis_instrumentation__.Notify(6)}}
	__antithesis_instrumentation__.Notify(2); return "C"
}
