package sample; import __antithesis_instrumentation__ "antithesis.notifier/instrumentation"

func Recv(a, b chan int) int {__antithesis_instrumentation__.Notify(1)
	select {
	case v := <-a:__antithesis_instrumentation__.Notify(2)
		return v
	case v := <-b:__antithesis_instrumentation__.Notify(3)
		return v
	}
}
