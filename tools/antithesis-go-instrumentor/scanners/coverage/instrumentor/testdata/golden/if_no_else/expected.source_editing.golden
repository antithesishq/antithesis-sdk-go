package sample; import __antithesis_instrumentation__ "antithesis.notifier/instrumentation"

// Sign has no else branch; the instrumentor synthesizes one so the
// not-taken path gets coverage.
func Sign(n int) int {__antithesis_instrumentation__.Notify(1)
	if n > 0 {__antithesis_instrumentation__.Notify(3)
		return 1
	} else {__antithesis_instrumentation__.Notify(4)}
	__antithesis_instrumentation__.Notify(2); return 0
}
