//line input.go:1:1
package sample; import __antithesis_instrumentation__ "antithesis.notifier/instrumentation"

var ready bool

// init is deliberately NOT instrumented -- it runs regardless, so counting
// it is just noise. Ready should still be instrumented.
func init() {
	ready = true
}

func Ready() bool {__antithesis_instrumentation__.Notify(1)
	return ready
}
