// The right operand of && is a func literal with control flow of its own.
// The short-circuit rewrite must instrument inside the literal's body (the
// AST-rewriting backend does), not copy it verbatim.
package sample; import __antithesis_instrumentation__ "antithesis.notifier/instrumentation"

func hasBig(a bool, n int) bool {__antithesis_instrumentation__.Notify(1)
	return a && func() bool { __antithesis_instrumentation__.Notify(2); return (func() bool {__antithesis_instrumentation__.Notify(3)
		if n > 1 {__antithesis_instrumentation__.Notify(5)
			return true
		} else {__antithesis_instrumentation__.Notify(6)}
		__antithesis_instrumentation__.Notify(4); return false
	}()) == true }() == true
}
