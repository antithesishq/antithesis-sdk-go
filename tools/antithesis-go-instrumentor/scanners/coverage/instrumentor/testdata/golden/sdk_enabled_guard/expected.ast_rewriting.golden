	__antithesis_instrumentation__.Notify(4)

//line input.go:19
	return "other"
}

//line input.go:23
func ExplicitElse(n int) string {
	__antithesis_instrumentation__.Notify(7)

//line input.go:24
	if assert.Enabled {
		__antithesis_instrumentation__.Notify(8)

//line input.go:25
		assert.Reachable("checked", nil)

//line input.go:26
		return "checked"

//line input.go:27
	} else {
