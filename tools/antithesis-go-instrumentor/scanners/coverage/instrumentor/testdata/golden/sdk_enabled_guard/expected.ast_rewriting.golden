//line input.go:35
func Negated(n int) string {
	__antithesis_instrumentation__.Notify(10)

//line input.go:36
	if !assert.Enabled {
		__antithesis_instrumentation__.Notify(12)

//line input.go:37
		return "disabled"

//line input.go:38
	} else {
		__antithesis_instrumentation__.Notify(13)
	}
	__antithesis_instrumentation__.Notify(11)

//line input.go:39
	assert.Sometimes(n == 0, "n is zero", nil)

//line input.go:40
	return "enabled"
}

//line input.go:45
func ElseIf(n int) string {
	__antithesis_instrumentation__.Notify(14)

//line input.go:46
	if n < 0 {
		__antithesis_instrumentation__.Notify(16)

//line input.go:47
		return "neg"

//line input.go:48
	} else {
		__antithesis_instrumentation__.Notify(17)

//line input.go:48
		if assert.Enabled {
			__antithesis_instrumentation__.Notify(18)

//line input.go:49
			assert.Always(n >= 0, "n is not negative in else-if", nil)

//line input.go:50
			return "nonneg"
		}
	}
	__antithesis_instrumentation__.Notify(15)

//line input.go:52
	return "quiet"
}
