//line input.go:8
func Guarded(n int) {
	__antithesis_instrumentation__.Notify(1)

//line input.go:9
	if assert.Enabled {
		__antithesis_instrumentation__.Notify(2)

//line input.go:10
		assert.Always(n >= 0, "n is not negative", nil)
	}
}

