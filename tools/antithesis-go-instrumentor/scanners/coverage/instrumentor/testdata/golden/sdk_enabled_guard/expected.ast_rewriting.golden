func Ordinary(n int) string {
	__antithesis_instrumentation__.Notify(3)

//line input.go:16
	if n > 0 {
		__antithesis_instrumentation__.Notify(5)

//line input.go:17
		return "pos"

//line input.go:18
	} else {
		__antithesis_instrumentation__.Notify(6)
