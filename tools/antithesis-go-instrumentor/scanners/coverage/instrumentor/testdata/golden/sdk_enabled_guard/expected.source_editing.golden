package sample; import __antithesis_instrumentation__ "antithesis.notifier/instrumentation"

import "github.com/antithesishq/antithesis-sdk-go/assert"

// The positive, no-else guard. assert.Enabled is a constant, so a synthesized
// else could never be taken; instrumenting it would leave a row in the symbol
// table that can never be notified.
func Guarded(n int) {__antithesis_instrumentation__.Notify(1)
	if assert.Enabled {__antithesis_instrumentation__.Notify(2)
		assert.Always(n >= 0, "n is not negative", nil)
	}
}

// An ordinary condition in the same file still gets its synthesized else.
func Ordinary(n int) string {__antithesis_instrumentation__.Notify(3)
	if n > 0 {__antithesis_instrumentation__.Notify(5)
		return "pos"
	} else {__antithesis_instrumentation__.Notify(6)}
	__antithesis_instrumentation__.Notify(4); return "other"
}

// An explicit else is left alone: there is nothing to synthesize.
func ExplicitElse(n int) string {__antithesis_instrumentation__.Notify(7)
	if assert.Enabled {__antithesis_instrumentation__.Notify(8)
		assert.Reachable("checked", nil)
		return "checked"
	} else {__antithesis_instrumentation__.Notify(9)
		return "unchecked"
	}
}

// The negated form is deliberately not special-cased. Here the body is the dead
// branch and the synthesized else is live, so suppressing the else would delete
// a real edge.
func Negated(n int) string {__antithesis_instrumentation__.Notify(10)
	if !assert.Enabled {__antithesis_instrumentation__.Notify(12)
		return "disabled"
	} else {__antithesis_instrumentation__.Notify(13)}
	__antithesis_instrumentation__.Notify(11); assert.Sometimes(n == 0, "n is zero", nil)
	return "enabled"
}

// As the else-if of another statement, where the enclosing wrapper's closing
// brace is inserted at the same offset the synthesized else would have used.
func ElseIf(n int) string {__antithesis_instrumentation__.Notify(14)
	if n < 0 {__antithesis_instrumentation__.Notify(16)
		return "neg"
	} else {__antithesis_instrumentation__.Notify(17); if assert.Enabled {__antithesis_instrumentation__.Notify(18)
		assert.Always(n >= 0, "n is not negative in else-if", nil)
		return "nonneg"
	}}
	__antithesis_instrumentation__.Notify(15); return "quiet"
}
